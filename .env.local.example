# Copy this file to .env.local and fill in your LOCAL Supabase credentials.
#
#   cp .env.local.example .env.local
#
# Get the values from the running local stack with:
#
#   supabase status --experimental
#
# Use the API URL and the publishable (anon-tier) key. Never put the
# service-role / secret key in this file — it must never reach the browser.
#
# .env.local is git-ignored; do not commit real credentials.

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_local_key_here
